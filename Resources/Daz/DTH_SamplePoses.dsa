
// DTH Pose Wizard: Daz Studio sampler.
//
// Records, in Daz's own evaluation (pose controls, limits, ERC, rotation orders and all), where every bone of a base
// Genesis 9 ends up under DTH's body ROM and under every body pose preset in the user's content library, and writes
// DTH_PoseSamples.json for the Unreal plugin. Nothing in the scene or the content library is changed or saved; the
// scene is replaced by a fresh Genesis 9, so the script stops if the current scene has unsaved changes.
//
// Pose presets are found the way Daz content is laid out: every pose preset (preset_pose or preset_hierarchical_pose)
// in any folder named "Poses" under People/ in every content directory, subfolders included. Folders for another
// figure generation are listed and skipped. "Expressions" folders belong to the Expression Wizard and are left out.
//
// Libraries can hold hundreds of thousands of presets, so nothing here holds the whole library at once:
// - the scan reads only the start of each file (its type) and writes the preset list in chunks of CHUNK presets;
// - the samples are written one chunk at a time (poses/poses_*.json), and DTH_PoseSamples.json only lists the chunks;
// - a run that stops (cancelled, or Daz closed) is resumed where it left off the next time the script runs. A preset that
//   was loading when Daz went down is tried once more; if Daz goes down on it again it is listed as not loaded.
//
// Positions are Daz world space (cm, Y up), rotations Daz world-space quaternions [x, y, z, w]. The plugin converts.
//
// Run it from Daz Studio (File > Open, or double-click), or through a script server with `var args = {...}` defined
// first. Without args it does every step with the defaults below.
//   args.step      "all" (default) | "prepare" | "sample" | "rom" | "finish"
//   args.out       output folder (default: Documents/DTH Pose Wizard)
//   args.fresh     true: start over even if an unfinished run is there to resume ("all")
//   args.folders   extra content-library folders to sample as well (all subfolders), e.g. ["My Stuff/Poses"]
//   args.files     sample only these preset files (absolute, or relative to a content directory) instead of the scan
//   args.romLast   last ROM frame to sample (default: the ROM's last key)
//   args.geometry  true: also write the base mesh's vertex positions for every sampled state, under <out>/geometry
//   args.chunk     ("sample") which chunk of the prepared list to sample (default: the first one not sampled yet)
//   args.skip      preset files not to load (each stopped Daz in an earlier run); listed as not loaded, with the reason
//   args.figure    load this figure or scene file instead of base Genesis 9 (to measure a character's own joints)
// The arguments can also be passed as the script's first argument (a script server that has no `args`).
(function(){
	// Arguments come as a global `args` (script servers that define it) or as the script's first argument.
	var passed = getArguments();
	var A = (typeof args !== "undefined" && args) ? args : (passed.length && typeof passed[0] == "object" ? passed[0] : {});
	var INTERACTIVE = !passed.length && typeof args === "undefined";
	var STEP = A.step || "all";
	var OUT = A.out || (App.getDocumentsPath() + "/DTH Pose Wizard");
	var WORK = OUT + "/work";
	var EXTRA_FOLDERS = A.folders || [];
	var FILES = A.files || null;
	var SKIP = {};
	for (var s = 0; A.skip && s < A.skip.length; s++) SKIP[A.skip[s]] = true;
	var GEOMETRY = !!A.geometry;
	var FIGURE_FILE = A.figure || "People/Genesis 9/Genesis 9.duf";
	// DazToHue's Genesis 9 ROM, the body preset the DTH guide loads on the figure; its frames give the JCM poses
	var ROM_DIR = "DazToHue/Poses/Genesis 9/DQS";
	var ROM_BASE = "G9 DQS JCM FAC - Base.duf";
	var CHANNELS = ["XRotate", "YRotate", "ZRotate", "XTranslate", "YTranslate", "ZTranslate"];
	// Presets per list and samples file: about 2.5 MB of samples each.
	var CHUNK = 100;
	// The lines of a preset file read to find its type: Daz writes asset_info.type within the first few.
	var HEADER_LINES = 40;
	var TITLE = "DTH Pose Wizard";
	var result = {step: STEP, messages: []};

	function note(s) { result.messages.push(s); print(s); }

	function contentPath(rel) {
		if (/^[A-Za-z]:[\/\\]|^\//.test(rel)) return new DzFileInfo(rel).exists() ? rel : "";
		var mgr = App.getContentMgr();
		for (var i = 0; i < mgr.getNumContentDirectories(); i++) {
			var p = mgr.getContentDirectoryPath(i) + "/" + rel;
			if (new DzFileInfo(p).exists()) return p;
		}
		return "";
	}

	function exists(path) { return new DzFileInfo(path).exists(); }
	function readText(path) { var f = new DzFile(path); if (!f.open(DzFile.ReadOnly)) return null; var t = f.read(); f.close(); return t; }
	function writeText(path, text) { var f = new DzFile(path); if (!f.open(DzFile.WriteOnly | DzFile.Truncate)) return false; f.write(text); f.close(); return true; }
	function readJson(path) { var t = readText(path); return t === null || t === "" ? null : JSON.parse(t); }
	function writeJson(path, value) { return writeText(path, JSON.stringify(value)); }
	function removeFile(path) { if (exists(path)) { var info = new DzFileInfo(path); new DzDir(info.path()).remove(info.fileName()); } }
	function pad(n) { var t = "" + n; while (t.length < 6) t = "0" + t; return t; }
	function listFile(c) { return WORK + "/list_" + pad(c) + ".json"; }
	// Relative to OUT: DTH_PoseSamples.json lists the chunks this way.
	function chunkName(c) { return "poses/poses_" + pad(c) + ".json"; }

	function readState() { var st = readJson(WORK + "/state.json"); return st && st.version == 2 ? st : null; }
	function writeState(st) { return writeJson(WORK + "/state.json", st); }
	function chunkDone(c) { return exists(OUT + "/" + chunkName(c)); }
	function chunksDone(st) { var n = 0; for (var c = 0; c < st.chunks; c++) if (chunkDone(c)) n++; return n; }

	function mainFigure() {
		for (var i = 0; i < Scene.getNumSkeletons(); i++) if (Scene.getSkeleton(i).getName() == "Genesis9") return Scene.getSkeleton(i);
		return null;
	}
	function channel(b, c) {
		if (c == "XRotate") return b.getXRotControl(); if (c == "YRotate") return b.getYRotControl();
		if (c == "ZRotate") return b.getZRotControl(); if (c == "XTranslate") return b.getXPosControl();
		if (c == "YTranslate") return b.getYPosControl(); return b.getZPosControl();
	}
	function round(v, d) { var m = Math.pow(10, d); return Math.round(v * m) / m; }

	// The figure's bones (with their channels and parents) and morph values, looked up once per figure: looking up its
	// 3,000 morphs and every bone's channels again for each preset took about 2.4 s of the 2.7 s a preset took.
	var REFS = null;
	function figureRefs() {
		if (REFS) return REFS;
		var fig = mainFigure(), all = [fig].concat(fig.getAllBones()), bones = [], morphs = [];
		for (var i = 0; i < all.length; i++) {
			var b = all[i], parent = b.getNodeParent(), ch = [];
			for (var c = 0; c < CHANNELS.length; c++) ch.push(channel(b, CHANNELS[c]));
			bones.push({node: b, name: b.getName(), parent: parent && parent.inherits("DzBone") ? parent.getName() : "", channels: ch});
		}
		var obj = fig.getObject();
		for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
			var mod = obj.getModifier(m);
			if (mod && mod.inherits("DzMorph")) morphs.push([mod.getName(), mod.getValueControl()]);
		}
		REFS = {bones: bones, morphs: morphs};
		return REFS;
	}

	// Every bone's world transform and evaluated local channels, and every morph that is not zero.
	function sample() {
		var refs = figureRefs(), bones = {}, morphs = {};
		for (var i = 0; i < refs.bones.length; i++) {
			var b = refs.bones[i], p = b.node.getWSPos(), r = b.node.getWSRot(), local = [];
			for (var c = 0; c < b.channels.length; c++) local.push(round(b.channels[c].getValue(), 6));
			bones[b.name] = {parent: b.parent, pos: [round(p.x, 6), round(p.y, 6), round(p.z, 6)],
				rot: [round(r.x, 8), round(r.y, 8), round(r.z, 8), round(r.w, 8)], local: local};
		}
		for (var m = 0; m < refs.morphs.length; m++) {
			var v = refs.morphs[m][1].getValue();
			if (Math.abs(v) > 1e-6) morphs[refs.morphs[m][0]] = round(v, 6);
		}
		return {bones: bones, morphs: morphs};
	}

	// The base mesh's vertices for this state (Daz world space, cm), one "x y z" line each.
	function writeGeometry(name) {
		if (!GEOMETRY) return "";
		var fig = mainFigure(), obj = fig.getObject();
		obj.forceCacheUpdate(fig, false);
		var g = obj.getCachedGeom(), n = g.getNumVertices(), lines = ["Genesis9 " + n];
		for (var v = 0; v < n; v++) { var p = g.getVertex(v); lines.push(p.x.toFixed(5) + " " + p.y.toFixed(5) + " " + p.z.toFixed(5)); }
		var dir = OUT + "/geometry";
		new DzDir(dir).mkpath(dir);
		var file = dir + "/" + name.replace(/[^A-Za-z0-9_\-]+/g, "_") + ".txt";
		writeText(file, lines.join("\n"));
		return file;
	}

	// User values of every bone channel, morph and figure pose control, to put the figure back after a preset.
	// Every numeric property of every figure in the scene (Genesis 9 and the figures fitted to it), of all their bones,
	// and of all their morphs: a preset can set any of them (eye controls, for one, are not under Pose Controls), and one
	// left set would carry into every preset sampled after it.
	function snapshot() {
		var snap = [];
		function add(p) { if (p && p.inherits("DzNumericProperty")) snap.push([p, p.getRawValue()]); }
		for (var s = 0; s < Scene.getNumSkeletons(); s++) {
			var fig = Scene.getSkeleton(s), nodes = [fig].concat(fig.getAllBones());
			for (var i = 0; i < nodes.length; i++)
				for (var n = 0; n < nodes[i].getNumProperties(); n++) add(nodes[i].getProperty(n));
			var obj = fig.getObject();
			for (var m = 0; obj && m < obj.getNumModifiers(); m++) {
				var mod = obj.getModifier(m);
				if (mod && mod.inherits("DzMorph")) add(mod.getValueControl());
			}
		}
		return snap;
	}
	// Only the properties the preset changed are set back: each set makes Daz re-evaluate the figure.
	function restore(snap) { for (var i = 0; i < snap.length; i++) if (snap[i][0].getRawValue() != snap[i][1]) snap[i][0].setValue(snap[i][1]); }
	// Properties a restore did not put back (a property driven by another one cannot be set): "" when all came back.
	function unrestored(snap) {
		var out = [];
		for (var i = 0; i < snap.length && out.length < 5; i++)
			if (Math.abs(snap[i][0].getRawValue() - snap[i][1]) > 1e-4) out.push(snap[i][0].getPath() + "/" + snap[i][0].getName());
		return out.join(", ");
	}

	// A preset's type from the start of its file, never the whole file. Compressed presets (gzip, not text) say nothing
	// here: samplePresets tells them apart when it loads them.
	function presetType(file) {
		var f = new DzFile(file);
		if (!f.open(DzFile.ReadOnly)) return "";
		var type = "";
		for (var i = 0; i < HEADER_LINES && !type; i++) {
			var line = f.readLine();
			if (!line) break;
			if (i == 0 && line.charAt(0) != "{") break;
			var m = /"type"\s*:\s*"([^"]+)"/.exec(line);
			if (m) type = m[1];
		}
		f.close();
		return type;
	}
	function isPoseType(t) { return t == "preset_pose" || t == "preset_hierarchical_pose"; }

	// The scan: presets go to the list files CHUNK at a time as they are found.
	function Scan() { this.buffer = []; this.chunks = 0; this.count = 0; this.skipped = []; this.seen = {}; this.cancelled = false; }
	Scan.prototype.flush = function() {
		if (!this.buffer.length) return;
		writeJson(listFile(this.chunks), this.buffer);
		this.chunks++;
		this.buffer = [];
	};

	function listPresets(scan) {
		var mgr = App.getContentMgr();
		if (FILES) {
			for (var f = 0; f < FILES.length && !scan.cancelled; f++) {
				var path = contentPath(FILES[f]);
				if (!path) { scan.skipped.push({file: FILES[f], reason: "not found in any content directory"}); continue; }
				var info = new DzFileInfo(path);
				addPreset(info.path(), info.path(), info.fileName(), scan);
			}
		}
		else {
			for (var i = 0; i < mgr.getNumContentDirectories() && !scan.cancelled; i++) {
				var root = mgr.getContentDirectoryPath(i);
				if (exists(root + "/People")) findPoseFolders(root, "People", scan);
				for (var e = 0; e < EXTRA_FOLDERS.length; e++)
					if (exists(root + "/" + EXTRA_FOLDERS[e])) walk(root + "/" + EXTRA_FOLDERS[e], EXTRA_FOLDERS[e], scan);
			}
		}
		scan.flush();
	}
	// Every folder named "Poses" below People/: sampled if it belongs to Genesis 9 (People/Genesis 9...), listed as
	// skipped otherwise.
	function findPoseFolders(root, rel, scan) {
		var dirs = new DzDir(root + "/" + rel).entryList(DzDir.Dirs | DzDir.NoDotAndDotDot, DzDir.Name);
		for (var j = 0; j < dirs.length && !scan.cancelled; j++) {
			var sub = rel + "/" + dirs[j], lower = dirs[j].toLowerCase();
			if (lower == "expressions") continue;
			if (lower == "poses") {
				var figure = sub.split("/")[1];
				if (figure.indexOf("Genesis 9") == 0) walk(root + "/" + sub, sub, scan);
				else scan.skipped.push({file: sub, reason: "made for " + figure + ", not Genesis 9"});
			}
			else findPoseFolders(root, sub, scan);
		}
	}
	function walk(dirPath, rel, scan) {
		var d = new DzDir(dirPath);
		var files = d.entryList(["*.duf"], DzDir.Files, DzDir.Name);
		for (var i = 0; i < files.length && !scan.cancelled; i++) addPreset(dirPath, rel, files[i], scan);
		var dirs = d.entryList(DzDir.Dirs | DzDir.NoDotAndDotDot, DzDir.Name);
		for (var j = 0; j < dirs.length && !scan.cancelled; j++) {
			if (dirs[j].toLowerCase() == "expressions") continue;
			walk(dirPath + "/" + dirs[j], rel + "/" + dirs[j], scan);
		}
	}
	function addPreset(dirPath, rel, file, scan) {
		if (scan.seen[rel + "/" + file]) return;
		scan.seen[rel + "/" + file] = true;
		stepProgress(1);
		if (progressIsCancelled()) { scan.cancelled = true; return; }
		var type = presetType(dirPath + "/" + file);
		if (type && !isPoseType(type)) { scan.skipped.push({file: rel + "/" + file, reason: "not a pose preset (" + type + ")"}); return; }
		var icon = "", stem = dirPath + "/" + file.replace(/\.duf$/, "");
		var icons = [dirPath + "/" + file + ".png", stem + ".png", stem + ".tip.png"];
		for (var k = 0; k < icons.length && !icon; k++) if (exists(icons[k])) icon = icons[k];
		scan.buffer.push({pack: rel, label: file.replace(/\.duf$/, ""), file: dirPath + "/" + file, icon: icon, type: type || "compressed"});
		scan.count++;
		if (scan.buffer.length == CHUNK) scan.flush();
	}

	// Files an earlier run (of this version or the one before) left in OUT, cleared before a fresh run.
	function clearRun() {
		var dirs = [OUT, WORK, OUT + "/poses"];
		var patterns = [/^samples_\d+\.json$/, /^presets\.json$/, /^progress\.txt$/, /^rest\.json$/, /^list_\d+\.json$/, /^state\.json$/, /^poses_\d+\.json$/];
		for (var d = 0; d < dirs.length; d++) {
			if (!exists(dirs[d])) continue;
			var files = new DzDir(dirs[d]).entryList(["*.json", "*.txt"], DzDir.Files, DzDir.Name);
			for (var f = 0; f < files.length; f++)
				for (var p = 0; p < patterns.length; p++) if (patterns[p].test(files[f])) { removeFile(dirs[d] + "/" + files[f]); break; }
		}
	}

	// A fresh base Genesis 9 in an empty scene.
	function loadFigure() {
		if (Scene.needsSave()) { result.error = "The open scene has unsaved changes. Save or close it, then run this again."; return false; }
		Scene.clear();
		REFS = null;
		var fig = contentPath(FIGURE_FILE);
		if (!fig) { result.error = "Genesis 9 is not installed (" + FIGURE_FILE + ")."; return false; }
		App.getContentMgr().openFile(fig, true);
		if (!mainFigure()) { result.error = "Loading Genesis 9 did not give a Genesis9 figure."; return false; }
		Scene.setTime(0);
		return true;
	}

	function prepare() {
		if (!loadFigure()) return false;
		clearRun();
		new DzDir(WORK).mkpath(WORK);
		new DzDir(OUT + "/poses").mkpath(OUT + "/poses");
		var scan = new Scan();
		startProgress(TITLE + ": finding pose presets", 0, true, true);
		try { listPresets(scan); } finally { finishProgress(); }
		if (scan.cancelled) { result.error = "Cancelled while finding the pose presets."; return false; }
		writeJson(OUT + "/skipped.json", scan.skipped);
		var rest = sample();
		rest.geometry = writeGeometry("rest");
		writeJson(WORK + "/rest.json", rest);
		writeState({version: 2, startedAt: new Date().toISOString(), presets: scan.count, chunks: scan.chunks, skipped: scan.skipped.length,
			suspects: {}, crashed: {}, rom: false, complete: false});
		note("Genesis 9 loaded; " + scan.count + " pose presets found, " + scan.skipped.length + " files or folders skipped.");
		return true;
	}

	// A preset that was loading when Daz went down (progress.txt is still there) is tried once more, then left out.
	function noteCrash(st) {
		var progress = readText(WORK + "/progress.txt");
		if (!progress) return;
		var file = progress.split("\t")[1] || "";
		removeFile(WORK + "/progress.txt");
		if (!file) return;
		st.suspects[file] = (st.suspects[file] || 0) + 1;
		if (st.suspects[file] >= 2) st.crashed[file] = true;
		writeState(st);
	}

	// Samples one chunk of the list into poses/poses_<chunk>.json. False if cancelled (nothing is written then).
	function sampleChunk(st, c, snap, counts) {
		var list = readJson(listFile(c)) || [];
		var main = mainFigure(), out = [];
		Scene.setTime(0);
		for (var i = 0; i < list.length; i++) {
			var p = list[i];
			stepProgress(1);
			if (progressIsCancelled()) return false;
			if (SKIP[p.file] || st.crashed[p.file]) {
				out.push({pack: p.pack, label: p.label, file: p.file, icon: p.icon, type: p.type, loaded: false, reason: "it stopped Daz Studio when loaded", state: null});
				counts.notLoaded++;
				continue;
			}
			// Which preset is loading, so a preset that stops Daz can be found and left out.
			writeText(WORK + "/progress.txt", (c * CHUNK + i) + "\t" + p.file);
			var nodes = Scene.getNumNodes();
			Scene.selectAllNodes(false); main.select(true); Scene.setPrimarySelection(main);
			var ok = App.getContentMgr().openFile(p.file, true), why = ok ? "" : "Daz could not load it";
			if (Scene.getNumNodes() != nodes) {
				// it added something to the scene, so it is not a pose preset: take it out again
				for (var n = Scene.getNumNodes() - 1; n >= nodes; n--) Scene.removeNode(Scene.getNode(n));
				ok = false; why = "not a pose preset (it adds items to the scene)";
			}
			var s = ok ? sample() : null;
			if (s) s.geometry = writeGeometry("preset_" + (c * CHUNK + i) + "_" + p.label);
			restore(snap);
			var left = unrestored(snap);
			if (left) counts.notRestored++;
			if (!ok) counts.notLoaded++;
			out.push({pack: p.pack, label: p.label, file: p.file, icon: p.icon, type: p.type, loaded: ok, reason: why, state: s, notRestored: left});
		}
		writeJson(OUT + "/" + chunkName(c), out);
		removeFile(WORK + "/progress.txt");
		return true;
	}

	// Every chunk not sampled yet. False if cancelled.
	function samplePresets(st) {
		var todo = [];
		for (var c = 0; c < st.chunks; c++) if (!chunkDone(c)) todo.push(c);
		if (!todo.length) return true;
		var snap = snapshot(), counts = {notLoaded: 0, notRestored: 0};
		var total = st.presets - (st.chunks - todo.length) * CHUNK;
		startProgress(TITLE + ": sampling " + total + " pose presets", Math.max(total, 1), true, true);
		var done = true;
		try {
			for (var t = 0; t < todo.length && done; t++) done = sampleChunk(st, todo[t], snap, counts);
		} finally { finishProgress(); }
		if (counts.notLoaded) note(counts.notLoaded + " presets did not load (the samples say why).");
		if (counts.notRestored) note(counts.notRestored + " presets left a property the figure could not set back (listed with each preset).");
		if (!done) { result.error = "Cancelled. Run the script again to carry on where it stopped."; return false; }
		return true;
	}

	function sampleRom(st) {
		var main = mainFigure();
		var base = contentPath(ROM_DIR + "/" + ROM_BASE);
		if (!base) { result.error = "DazToHue's Genesis 9 ROM preset (" + ROM_DIR + "/" + ROM_BASE + ") is missing."; return false; }
		var range = new DzTimeRange(0, 2000 * Scene.getTimeStep());
		Scene.setAnimRange(range); Scene.setPlayRange(range);
		Scene.setTime(0);
		var snap = snapshot();
		Scene.selectAllNodes(false); main.select(true); Scene.setPrimarySelection(main);
		App.getContentMgr().openFile(base, true);

		// The last keyed frame of any bone channel of the figure.
		var lastKey = 0, all = [main].concat(main.getAllBones());
		for (var i = 0; i < all.length; i++)
			for (var c = 0; c < CHANNELS.length; c++) {
				var ch = channel(all[i], CHANNELS[c]);
				for (var k = 0; k < ch.getNumKeys(); k++) lastKey = Math.max(lastKey, Math.round(ch.getKeyTime(k) / Scene.getTimeStep()));
			}
		var last = (typeof A.romLast == "number") ? Math.min(A.romLast, lastKey) : lastKey;
		var frames = {};
		for (var fr = 0; fr <= last; fr++) {
			Scene.setTime(fr * Scene.getTimeStep());
			var s = sample();
			s.geometry = writeGeometry("rom_" + fr);
			frames["" + fr] = s;
		}
		Scene.setTime(0);
		// Take the ROM's keys off again, so the figure is as prepare left it.
		for (var j = 0; j < all.length; j++)
			for (var c2 = 0; c2 < CHANNELS.length; c2++) { var cc = channel(all[j], CHANNELS[c2]); if (cc.getNumKeys() > 0) cc.deleteAllKeys(); }
		restore(snap);
		writeJson(OUT + "/rom.json", {basePreset: ROM_DIR + "/" + ROM_BASE, lastKey: lastKey, frames: frames});
		st.rom = true;
		writeState(st);
		note("Sampled DTH's ROM: frames 0 to " + last + " (last key " + lastKey + ").");
		return true;
	}

	// DTH_PoseSamples.json: the rest state and the list of samples files, never the samples themselves.
	function finish(st) {
		var chunks = [];
		for (var c = 0; c < st.chunks; c++) {
			if (!chunkDone(c)) { result.error = "Presets " + (c * CHUNK) + " to " + (Math.min(st.presets, (c + 1) * CHUNK) - 1) + " were not sampled."; return false; }
			chunks.push(chunkName(c));
		}
		var doc = {format: "DTH Pose Samples", version: 2, sampledAt: new Date().toISOString(),
			dazVersion: App.longVersionString, figure: "Genesis 9", units: "cm, Y up, Daz world space",
			extraFolders: EXTRA_FOLDERS, files: FILES, presets: st.presets,
			rest: readJson(WORK + "/rest.json"), rom: st.rom ? "rom.json" : "", chunks: chunks, skipped: "skipped.json"};
		writeJson(OUT + "/DTH_PoseSamples.json", doc);
		st.complete = true;
		writeState(st);
		result.file = OUT + "/DTH_PoseSamples.json";
		note("Wrote " + result.file + " (" + st.presets + " pose presets in " + chunks.length + " files).");
		return true;
	}

	// An unfinished run to carry on, or null for a fresh one.
	function resumable() {
		var st = readState();
		if (!st || st.complete || A.fresh) return null;
		if (!INTERACTIVE) return st;
		var q = MessageBox.question("An unfinished run from " + st.startedAt + " is in " + OUT + ": " + Math.min(st.presets, chunksDone(st) * CHUNK) +
			" of " + st.presets + " pose presets sampled.\n\nCarry on where it stopped, or start over (finds the presets again)?",
			TITLE, "&Carry On", "&Start Over", "&Cancel");
		if (q == 2) { result.error = "cancelled"; return null; }
		return q == 0 ? st : null;
	}

	function all() {
		var st = resumable();
		if (result.error) return false;
		if (st) {
			if (!loadFigure()) return false;
			noteCrash(st);
			note("Carrying on the run from " + st.startedAt + ".");
		}
		else {
			if (!prepare()) return false;
			st = readState();
		}
		if (!samplePresets(st)) return false;
		if (!st.rom && !sampleRom(st)) return false;
		return finish(st);
	}

	function step() {
		if (STEP == "prepare") return prepare();
		var st = readState();
		if (!st) { result.error = "Nothing prepared in " + OUT + ": run the prepare step first."; return false; }
		if (STEP == "sample") {
			if (!mainFigure() && !loadFigure()) return false;
			noteCrash(st);
			var c = typeof A.chunk == "number" ? A.chunk : -1;
			for (var i = 0; c < 0 && i < st.chunks; i++) if (!chunkDone(i)) c = i;
			if (c < 0 || c >= st.chunks) { result.next = -1; return true; }
			var counts = {notLoaded: 0, notRestored: 0};
			startProgress(TITLE + ": sampling chunk " + c, CHUNK, true, true);
			var done;
			try { done = sampleChunk(st, c, snapshot(), counts); } finally { finishProgress(); }
			if (!done) { result.error = "Cancelled."; return false; }
			result.next = -1;
			for (var j = 0; j < st.chunks; j++) if (!chunkDone(j)) { result.next = j; break; }
			note("Sampled chunk " + c + " of " + st.chunks + ".");
			return true;
		}
		if (STEP == "rom") return sampleRom(st);
		if (STEP == "finish") return finish(st);
		result.error = "Unknown step " + STEP + ".";
		return false;
	}

	if (STEP == "all") {
		all();
		if (INTERACTIVE && result.error != "cancelled") {
			if (result.error) MessageBox.critical(result.messages.concat([result.error]).join("\n"), TITLE, "OK");
			else MessageBox.information(result.messages.join("\n"), TITLE, "OK");
		}
	}
	else step();
	return result;
})();
